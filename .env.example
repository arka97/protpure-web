# ---- Required ----
DATABASE_URL=postgres://user:password@host:5432/protpure
PAYLOAD_SECRET=generate-a-long-random-string        # e.g. openssl rand -hex 32
NEXT_PUBLIC_SERVER_URL=https://protpure.com          # public origin, no trailing slash (inlined at build time)

# ---- Email (Resend) ----
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=no-reply@protpure.com                     # must be on a domain verified in Resend
EMAIL_FROM_NAME=Protpure Tech
# EMAIL_OVERRIDE_TO=you@example.com                  # dev only: route every email to one inbox

# ---- Seeding (first run only; remove afterwards) ----
SEED_ADMIN_EMAIL=rucha@protpure.com
SEED_ADMIN_PASSWORD=change-me-immediately
# SEED_TOKEN=long-random-string   # enables POST /api/seed on the server

# PAYLOAD_DB_PUSH=false   # dev only: disable automatic schema push (shared database / parallel branches)
